{
  "name": "entrega-final-backend-2-coderhouse",
  "version": "1.0.0",
  "description": "Servidor ecommerce con arquitectura en capas (DAO, Repository, DTO), autorización por roles, recuperación de contraseña por mail y lógica de compra con tickets.",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/e2e.test.js"
  },
  "keywords": [
    "express",
    "mongoose",
    "passport",
    "jwt",
    "repository-pattern",
    "dto",
    "coderhouse"
  ],
  "author": "Sebastián Felipe Muñoz Rivera",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "mongoose-paginate-v2": "^1.9.0",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
