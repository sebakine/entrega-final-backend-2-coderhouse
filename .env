# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

# ─── Persistencia ───────────────────────────────────────────
# PERSISTENCE selecciona la implementación de DAO en src/dao/factory.js
PERSISTENCE=MONGO
MONGO_URL=mongodb://127.0.0.1:27017/ecommerce_backend2

# ─── Autenticación (JWT en cookie firmada) ─────────────────
JWT_SECRET=28a761ed9258fb098ad467cf23870a19cb5d874fad6e95576bd0759d2fae011a
JWT_EXPIRES_IN=24h
COOKIE_NAME=currentUser
COOKIE_SECRET=e6bc3aa6c51376e0f5a2984494d974fa11036a372da36dc89da3eb44db6a22be
BCRYPT_SALT_ROUNDS=10

# ─── Recuperación de contraseña ────────────────────────────
RESET_PASSWORD_SECRET=0b31e0730f79b82adb8ae8277f3890142ecb188022a90f9e0566900a64e96d94
RESET_PASSWORD_EXPIRES_IN=1h

# ─── Mailing (Nodemailer) ──────────────────────────────────
# Para enviar correos reales con Gmail: MAIL_USER = tu cuenta y MAIL_PASS = contraseña de aplicación.
# Si se dejan vacíos, los correos se muestran en la consola del servidor (modo desarrollo).
MAIL_SERVICE=gmail
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Ecommerce Coderhouse <no-reply@ecommerce.local>"

# ─── Usuario administrador (npm run seed) ──────────────────
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=Admin1234
